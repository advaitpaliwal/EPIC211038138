      <DESCRIPTION>Gaia DR2 source number</DESCRIPTION>
      <LINK href="http://vizier.cds.unistra.fr/viz-bin/VizieR-4?-info=XML&amp;-out.add=.&amp;-source=I/345/gaia2&amp;Source=${Source}"/>
    </FIELD>
    <FIELD name="dist50" ucd="pos.distance" datatype="double" width="10" precision="6" unit="kpc"><!-- ucd="PHYS_DISTANCE_TRUE" -->
      <DESCRIPTION>StarHorse distance, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="AV50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction at {lambda}=5420{AA}, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="AG50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction in the G band, derived from AV50 and teff50</DESCRIPTION>
    </FIELD>
    <FIELD name="teff50" ucd="phys.temperature.effective" datatype="double" width="8" precision="2" unit="K"><!-- ucd="PHYS_TEMP_EFFEC" -->
      <DESCRIPTION>StarHorse effective temperature, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="logg50" ucd="phys.gravity" datatype="double" width="9" precision="6" unit="log(cm.s**-2)"><!-- ucd="PHYS_GRAVITY_SURFACE" -->
      <DESCRIPTION>StarHorse surface gravity, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="met50" ucd="phys.abund.Fe" datatype="double" width="9" precision="6"><!-- ucd="PHYS_ABUND_FE/H" -->
      <DESCRIPTION>StarHorse metallicity, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="mass50" ucd="phys.mass" datatype="double" width="9" precision="6" unit="solMass"><!-- ucd="PHYS_MASS_MISC" -->
      <DESCRIPTION>StarHorse stellar mass, 50th percentile</DESCRIPTION>
    </FIELD>
    <FIELD name="ABP50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction in the GBP band, 50th percentile, derived from AV50 and teff50</DESCRIPTION>
    </FIELD>
    <FIELD name="ARP50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction in the GRP band, 50th percentile, derived from AV50 and teff50</DESCRIPTION>
    </FIELD>
    <FIELD name="BP-RP0" ucd="phot.mag.reddFree" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_CI_B-R" -->
      <DESCRIPTION>? StarHorse dereddened colour (GBP-GRP)_0), derived from phot_bp_mean_mag, phot_rp_mean_mag, ABP50, and ARP50</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="MG0" ucd="phys.magAbs" datatype="double" width="10" precision="6" unit="mag"><!-- ucd="PHOT_ABS-MAG_BAND" -->
      <DESCRIPTION>StarHorse absolute magnitude, derived from phot_g_mean_mag (recalibrated), dist50, and AG50</DESCRIPTION>
    </FIELD>
    <FIELD name="XGal" ucd="pos.cartesian.x;pos.galactocentric" datatype="double" width="11" precision="6" unit="kpc"><!-- ucd="POS_GAL_X" -->
      <DESCRIPTION>StarHorse Galactocentric Cartesian X co-ordinate, derived from dist50 and assuming R0=8.2kpc</DESCRIPTION>
    </FIELD>
    <FIELD name="YGal" ucd="pos.cartesian.y;pos.galactocentric" datatype="double" width="11" precision="6" unit="kpc"><!-- ucd="POS_GAL_Y" -->
      <DESCRIPTION>StarHorse Galactocentric Cartesian Y co-ordinate, derived from dist50 and assuming R0=8.2kpc</DESCRIPTION>
    </FIELD>
    <FIELD name="ZGal" ucd="src.redshift;pos.galactocentric;pos.cartesian" datatype="double" width="11" precision="6" unit="kpc"><!-- ucd="POS_GAL_Z" -->
      <DESCRIPTION>StarHorse Galactocentric Cartesian Z co-ordinate, derived from dist50 and assuming R0=8.2kpc</DESCRIPTION>
    </FIELD>
    <FIELD name="RGal" ucd="pos.distance;pos.galactocentric" datatype="double" width="10" precision="6" unit="kpc"><!-- ucd="POS_GAL_GC" -->
      <DESCRIPTION>StarHorse Galactocentric planar distance, derived from XGal and YGal</DESCRIPTION>
    </FIELD>
    <FIELD name="ruwe" ucd="meta.code.qual" datatype="double" width="10" precision="6"><!-- ucd="CODE_QUALITY" -->
      <DESCRIPTION>Gaia DR2 renormalised unit-weight error (Lindegren et al., 2018A&amp;A...616A...2L)</DESCRIPTION>
    </FIELD>
