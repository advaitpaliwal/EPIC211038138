    </FIELD>
    <FIELD name="m-M" ucd="phot.mag.distMod" datatype="float" width="6" precision="3" unit="mag"><!-- ucd="PHOT_DIST-MOD" -->
      <DESCRIPTION>[5.3/6.1] Distance modulus</DESCRIPTION>
