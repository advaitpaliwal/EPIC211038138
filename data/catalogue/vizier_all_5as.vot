      <DESCRIPTION>Distance from center (060.2741600000+23.5789600000)[ICRS], at Epoch=J2015.5</DESCRIPTION>
    </FIELD>
    <FIELD name="RA_ICRS" ucd="pos.eq.ra;meta.main" ref="H_2015.500" datatype="double" width="14" precision="10" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Barycentric right ascension (ICRS) at Ep=2015.5 (from Gaia DR2)</DESCRIPTION>
    </FIELD>
    <FIELD name="DE_ICRS" ucd="pos.eq.dec;meta.main" ref="H_2015.500" datatype="double" width="14" precision="10" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Barycentric declination (ICRS) at Ep=2015.5 (from Gaia DR2)</DESCRIPTION>
    </FIELD>
