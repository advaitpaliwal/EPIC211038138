      <DESCRIPTION>Unique source identifier (source_id)) (1)</DESCRIPTION>
      <LINK href="http://vizier.cds.unistra.fr/viz-bin/VizieR-4?-info=XML&amp;-out.add=.&amp;-source=I/345/gaia2&amp;Source=${GaiaDR2}"/>
    </FIELD>
    <FIELD name="RA_ICRS" ucd="pos.eq.ra;meta.main" ref="H_2015.500" datatype="double" width="8" precision="4" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Barycentric right ascension (ICRS) at Ep=2015.5 (RA_ICRS)</DESCRIPTION>
    </FIELD>
    <FIELD name="DE_ICRS" ucd="pos.eq.dec;meta.main" ref="H_2015.500" datatype="double" width="8" precision="4" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Barycentric declination (ICRS) at Ep=2015.5 (DE_ICRS)</DESCRIPTION>
    </FIELD>
    <FIELD name="A0best" ucd="phys.absorption" datatype="double" width="7" precision="4" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the dust extinction A0 (A0_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="R0best" ucd="phys.absorption" datatype="double" width="8" precision="5"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the average dust grain size extinction parameter (R0_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="dmodbest" ucd="phot.mag.distMod" datatype="double" width="7" precision="4" unit="mag"><!-- ucd="PHOT_DIST-MOD" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the distance modulus (dmod_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="logAbest" ucd="time.age" datatype="double" width="7" precision="4" unit="log(yr)"><!-- ucd="STAT_LIKELIHOOD" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the log10 of the age (logA_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="logLbest" ucd="phys.luminosity" datatype="double" width="8" precision="5" unit="log(solLum)"><!-- ucd="PHYS_LUMINOSITY_GENERAL" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the log10 of the luminosity (logL_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="logMbest" ucd="phys.mass" datatype="double" width="8" precision="5" unit="log(solMass)"><!-- ucd="PHYS_MASS_MISC" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the log10 of the mass (logM_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="logTbest" ucd="phys.temperature" datatype="double" width="8" precision="5" unit="log(K)"><!-- ucd="PHYS_TEMP_EFFEC" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the log10 of the effective temperature (logT_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="loggbest" ucd="phys.gravity" datatype="double" width="7" precision="4" unit="log(cm.s**-2)"><!-- ucd="PHYS_GRAVITY_SURFACE" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the log10 of the surface gravity (logg_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="ABPbest" ucd="phys.absorption;em.opt.B" datatype="double" width="7" precision="4" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>multivariate maximum posterior estimate for the attenuation in the Gaia BP band towards this source (A_BP_best)</DESCRIPTION>
    </FIELD>
    <FIELD name="AGbest" ucd="phys.absorption;em.opt" datatype="double" width="7" precision="4" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
