      <DESCRIPTION>[0.01/1.3] Uncertainty in plx</DESCRIPTION>
    </FIELD>
    <FIELD name="RUWE" ucd="stat.error" datatype="float" width="6" precision="3"><!-- ucd="ERROR" -->
