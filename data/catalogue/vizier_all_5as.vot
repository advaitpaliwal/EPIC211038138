  <TABLE ID="J_AJ_169_116_table1" name="J/AJ/169/116/table1">
    <DESCRIPTION>Observational data and kinematic membership probabilities of stars in the region of the Pleiades</DESCRIPTION>
    <!-- RowName: ${GaiaDR3} -->
    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: J/AJ/169/116/table1 -->
    <FIELD name="_r" ucd="pos.angDistance" datatype="double" width="4" precision="2"><!-- ucd="POS_ANG_DIST_GENERAL" -->
      <DESCRIPTION>Distance from center (060.27416+23.57896)[FK5/J2000]</DESCRIPTION>
    </FIELD>
    <FIELD name="GaiaDR3" ucd="meta.id;meta.main" datatype="long" width="18"><!-- ucd="ID_MAIN" -->
      <DESCRIPTION>Gaia DR3 (I/355) identifier</DESCRIPTION>
      <LINK href="http://vizier.cds.unistra.fr/viz-bin/VizieR-4?-info=XML&amp;-out.add=.&amp;-source=I/355/gaiadr3&amp;Source=${GaiaDR3}"/>
    </FIELD>
    <FIELD name="RAdeg" ucd="pos.eq.ra" datatype="float" width="6" precision="3" unit="deg"><!-- ucd="POS_EQ_RA_OTHER" -->
      <DESCRIPTION>[46/67] Gaia DR3 right ascension (ICRS at Epoch=J2016.0)</DESCRIPTION>
    </FIELD>
    <FIELD name="DEdeg" ucd="pos.eq.dec" datatype="float" width="6" precision="3" unit="deg"><!-- ucd="POS_EQ_DEC_OTHER" -->
      <DESCRIPTION>[15/33] Gaia DR3 declination (ICRS at Epoch=J2016.0)</DESCRIPTION>
    </FIELD>
    <FIELD name="pmRA" ucd="pos.pm;pos.eq.ra" ref="J2000" datatype="float" width="7" precision="2" unit="mas/yr"><!-- ucd="POS_EQ_PMRA" -->
      <DESCRIPTION>[-160/612] Gaia DR3 proper motion along RA</DESCRIPTION>
    </FIELD>
    <FIELD name="e_pmRA" ucd="stat.error;pos.pm;pos.eq.ra" datatype="float" width="5" precision="2" unit="mas/yr"><!-- ucd="ERROR" -->
      <DESCRIPTION>[0.01/1.3] Uncertainty in pmRA</DESCRIPTION>
    </FIELD>
    <FIELD name="pmDE" ucd="pos.pm;pos.eq.dec" ref="J2000" datatype="float" width="7" precision="2" unit="mas/yr"><!-- ucd="POS_EQ_PMDEC" -->
      <DESCRIPTION>[-529/84] Gaia DR3 proper motion along DE</DESCRIPTION>
    </FIELD>
    <FIELD name="e_pmDE" ucd="stat.error;pos.pm;pos.eq.dec" datatype="float" width="5" precision="2" unit="mas/yr"><!-- ucd="ERROR" -->
      <DESCRIPTION>[0.01/0.9] Uncertainty in pmDE</DESCRIPTION>
    </FIELD>
